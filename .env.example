# ==============================================================================
# AI Academic Assistant Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit the '.env' file to version control.

# --- LLM API Keys ---
# Google Gemini API key (Required for LangChain Gemini service)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Application Configuration ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Storage Settings ---
# Absolute or relative paths to storage directories
UPLOADS_DIR=data/uploads
VECTOR_STORE_DIR=data/vector_store

# --- Model Configurations ---
# Google Gemini model to use for chat/QA (e.g., gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Google Gemini model to use for generating text embeddings (e.g., text-embedding-004)
EMBEDDING_MODEL=text-embedding-004
